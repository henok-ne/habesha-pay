# Copy this file to .env.local and fill in your real values.
# Get these from your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Settings -> API -> service_role key. NEVER prefix this with NEXT_PUBLIC_ —
# it must stay server-side only. It powers the employee self-service portal
# API route (src/app/api/portal/[token]/route.js), which deliberately
# bypasses Row Level Security because the portal has no logged-in user —
# the token itself is the credential.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Used server-side only (API routes) to sign/verify client portal tokens.
# Generate one with: openssl rand -base64 32
PORTAL_TOKEN_SECRET=replace-with-a-long-random-string
